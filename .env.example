# Study Vault Backend Environment Variables Example
# Duplicate this file as .env and fill in the values for your local or production setup.
# WARNING: Never commit .env or secrets to version control.

# Django Core Settings
SECRET_KEY=django-insecure-change-this-to-a-very-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_NAME=studyvault_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Alternatively, configure using a full database URL:
# DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/studyvault_db

# CORS Configuration
# Comma-separated list of origins permitted to make cross-origin HTTP requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# JWT Configuration (Optional overrides)
# ACCESS_TOKEN_LIFETIME_MINUTES=60
# REFRESH_TOKEN_LIFETIME_DAYS=7
